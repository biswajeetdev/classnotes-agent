# Copy to $CLASSNOTES_ROOT/.env and fill in. That file is chmod 600 and never leaves the machine.
#
#   cp $CLASSNOTES_ROOT/.env.example $CLASSNOTES_ROOT/.env
#   # paste your key, then:
#   chmod 600 $CLASSNOTES_ROOT/.env
#
# Get a key at https://console.groq.com/keys

GROQ_API_KEY=

# Used for the bulk digest pass. 70b is the quality/cost sweet spot for this job.
GROQ_MODEL=llama-3.3-70b-versatile
